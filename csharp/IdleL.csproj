<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
    <PackageReference Include="Silk.NET.GLFW" Version="2.23.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
  </ItemGroup>

  <!-- Recompile the Slang shader to SPIR-V on build when the Vulkan SDK is present (incremental:
       only when the .slang is newer). Falls back to the committed .spv if slangc isn't available. -->
  <Target Name="CompileShaders" BeforeTargets="BeforeBuild" Inputs="..\shaders\triangle.slang;..\shaders\cull.slang;..\shaders\hiz.slang;..\shaders\static.slang" Outputs="..\shaders\triangle.spv;..\shaders\cull.spv;..\shaders\hiz.spv;..\shaders\static.spv" Condition="'$(VULKAN_SDK)' != '' And Exists('$(VULKAN_SDK)\Bin\slangc.exe')">
    <Exec Command="&quot;$(VULKAN_SDK)\Bin\slangc.exe&quot; &quot;$(MSBuildProjectDirectory)\..\shaders\triangle.slang&quot; -target spirv -profile spirv_1_5 -matrix-layout-row-major -o &quot;$(MSBuildProjectDirectory)\..\shaders\triangle.spv&quot;" />
    <Exec Command="&quot;$(VULKAN_SDK)\Bin\slangc.exe&quot; &quot;$(MSBuildProjectDirectory)\..\shaders\cull.slang&quot; -target spirv -profile spirv_1_5 -matrix-layout-row-major -o &quot;$(MSBuildProjectDirectory)\..\shaders\cull.spv&quot;" />
    <Exec Command="&quot;$(VULKAN_SDK)\Bin\slangc.exe&quot; &quot;$(MSBuildProjectDirectory)\..\shaders\hiz.slang&quot; -target spirv -profile spirv_1_5 -matrix-layout-row-major -o &quot;$(MSBuildProjectDirectory)\..\shaders\hiz.spv&quot;" />
    <Exec Command="&quot;$(VULKAN_SDK)\Bin\slangc.exe&quot; &quot;$(MSBuildProjectDirectory)\..\shaders\static.slang&quot; -target spirv -profile spirv_1_5 -matrix-layout-row-major -o &quot;$(MSBuildProjectDirectory)\..\shaders\static.spv&quot;" />
  </Target>

  <!-- The committed .spv is copied next to the binary so the renderer can load it. -->
  <ItemGroup>
    <None Include="..\shaders\triangle.spv" Link="shaders\triangle.spv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\shaders\cull.spv" Link="shaders\cull.spv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\shaders\hiz.spv" Link="shaders\hiz.spv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\shaders\static.spv" Link="shaders\static.spv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
